# ==========================================
# Lyftr AI Full-Stack Assignment Environment Variables
# ==========================================

# Comma-separated list of at least 2 LLM API keys.
# Keys are assigned internal identifiers in order: key_1, key_2, ...
# Example for Google Gemini: AIzaSyD...,AIzaSyB...
# Example for OpenAI: sk-proj-1...,sk-proj-2...
LLM_API_KEYS=your-first-api-key-here,your-second-api-key-here

# SQLite Database connection URL.
# In Docker compose: sqlite:////data/app.db (persisted on /data volume)
# In local development without Docker: sqlite:///./app.db
DATABASE_URL=sqlite:////data/app.db

# Comma-separated list of allowed CORS origins for FastAPI.
# In development: http://localhost:3000,http://127.0.0.1:3000
# In production: https://your-frontend-domain.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Enables the X-Simulate-Failure header test hook.
# Set to true to test key failovers (key_1=429, key_1=500, *=429).
ENABLE_FAILURE_SIMULATION=true

# LiteLLM compatible model name.
# Examples: gemini/gemini-2.0-flash, gpt-4o-mini, groq/llama-3.1-8b-instant
LLM_MODEL=gemini/gemini-2.0-flash

# Frontend API base URL (used during frontend build/runtime).
# Local Docker / development: http://localhost:8000
# Production: https://your-backend-api.onrender.com
VITE_API_BASE_URL=http://localhost:8000
